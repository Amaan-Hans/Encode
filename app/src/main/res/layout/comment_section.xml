<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/question_card_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#7F93B2"
            app:cardCornerRadius="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <TextView
                    android:id="@+id/question_username"
                    android:layout_width="179dp"
                    android:layout_height="27dp"
                    android:layout_marginTop="4dp"
                    android:paddingStart="0.5dp"
                    android:paddingTop="0.5dp"
                    android:paddingEnd="0.5dp"
                    android:paddingBottom="0.5dp"
                    android:text="Amaan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/question_question_card"
                    android:layout_width="365dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="How do i use SQL"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/question_username"
                    app:layout_constraintVertical_bias="0.0" />

                <ImageButton
                    android:id="@+id/return_button"
                    android:layout_width="23dp"
                    android:layout_height="17dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="12dp"
                    android:background="@android:color/transparent"
                    android:onClick="home_page"
                    android:scaleType="centerInside"
                    app:layout_constraintEnd_toStartOf="@+id/question_like_button"
                    app:layout_constraintTop_toBottomOf="@+id/question_question_card"
                    app:srcCompat="?attr/homeAsUpIndicator" />

                <TextView
                    android:id="@+id/question_likecount"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageButton
                    android:id="@+id/question_like_button"
                    android:layout_width="25dp"
                    android:layout_height="23dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="1dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/question_likecount"
                    app:layout_constraintTop_toBottomOf="@+id/question_question_card"
                    app:layout_constraintVertical_bias="0.062"
                    app:srcCompat="@drawable/like_icon" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/commentview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>


